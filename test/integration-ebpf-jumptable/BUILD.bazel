load("//bazel:bpf.bzl", "bpfeb_filegroup", "bpfel_filegroup")
load("//bazel:rust.bzl", "aya_crate_binary_names", "aya_rust_crate")

INTEGRATION_EBPF_JUMPTABLE_BINS = aya_crate_binary_names()

# Programs that only exercise jump tables (`gotox`) when LLVM is told to emit
# them. Keep these flags synchronized with JUMP_TABLE_RUSTFLAGS in
# test/integration-test/build.rs.
aya_rust_crate(
    name = "integration-ebpf-jumptable",
    binary_rustc_flags = [
        "-Clink-arg=--btf",
        "-Ctarget-cpu=v4",
        "-Clink-arg=--llvm-args=-bpf-min-jump-table-entries=4",
    ],
    binary_unit_tests = [],
    build_script = False,
    ebpf = True,
)

bpfeb_filegroup(
    name = "bpfeb",
    srcs = INTEGRATION_EBPF_JUMPTABLE_BINS,
    visibility = ["//visibility:public"],
)

bpfel_filegroup(
    name = "bpfel",
    srcs = INTEGRATION_EBPF_JUMPTABLE_BINS,
    visibility = ["//visibility:public"],
)
