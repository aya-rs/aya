load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:bpf.bzl", "aya_c_bpf_objects")
load("//bazel:rust.bzl", "aya_rust_crate")
load("//test/kernel:kernel.bzl", "KERNEL_LINES")
load(":variants.bzl", "host_arch_filegroup", "opt_filegroup")
load(":vm.bzl", "aya_integration_vm_test")

# Keep this list synchronized with C_BPF in build.rs. The Boolean requests the
# additional .BTF section used by the corresponding relocation test.
C_BPF_OBJECTS = [
    ("bpf/ext.bpf.c", False),
    ("bpf/iter.bpf.c", True),
    ("bpf/main.bpf.c", False),
    ("bpf/multimap-btf.bpf.c", False),
    ("bpf/ringbuf-btf.bpf.c", True),
    ("bpf/enum_signed_32_checked_variants_reloc.bpf.c", True),
    ("bpf/enum_signed_32_reloc.bpf.c", True),
    ("bpf/enum_signed_64_checked_variants_reloc.bpf.c", True),
    ("bpf/enum_signed_64_reloc.bpf.c", True),
    ("bpf/enum_unsigned_32_checked_variants_reloc.bpf.c", True),
    ("bpf/enum_unsigned_32_reloc.bpf.c", True),
    ("bpf/enum_unsigned_64_checked_variants_reloc.bpf.c", True),
    ("bpf/enum_unsigned_64_reloc.bpf.c", True),
    ("bpf/field_reloc.bpf.c", True),
    ("bpf/flex_array_reloc.bpf.c", True),
    ("bpf/nonfinal_zero_array_reloc.bpf.c", False),
    ("bpf/nested_array_bounds_reloc.bpf.c", False),
    ("bpf/target_fixed_array_reloc.bpf.c", True),
    ("bpf/target_nonfinal_zero_array_reloc.bpf.c", True),
    ("bpf/pointer_reloc.bpf.c", True),
    ("bpf/struct_flavors_reloc.bpf.c", True),
    ("bpf/text_64_64_reloc.c", False),
    ("bpf/variables_reloc.bpf.c", False),
    ("bpf/func_info_missing_callee.bpf.c", False),
    ("bpf/func_info_missing_program.bpf.c", False),
    ("bpf/func_info_absent.bpf.c", False),
    ("bpf/ksyms.bpf.c", True),
    ("bpf/ksyms_strong.bpf.c", True),
    ("bpf/ksyms_typed_missing_kfunc.bpf.c", True),
    ("bpf/ksyms_typed_missing_var.bpf.c", True),
    ("bpf/ksyms_typeless_missing.bpf.c", True),
]

aya_c_bpf_objects(
    name = "c_bpf_objects",
    hdrs = [
        "bpf/reloc.h",
        "bpf/struct_with_scalars.h",
    ],
    objects = C_BPF_OBJECTS,
    vmlinux = "@crates//:libbpf-sys-vmlinux-h-1.7.0+v1.7.0",
    deps = ["@libbpf"],
)

copy_to_directory(
    name = "bpf_out_dir",
    # build.rs puts the same C and Rust BPF outputs in OUT_DIR for Cargo builds.
    # test/integration-test/src/lib.rs reads each output by this basename.
    srcs = [
        ":c_bpf_objects",
        "//test/integration-ebpf:bpfel",
    ],
    root_paths = [
        ".",
        "test/integration-ebpf",
    ],
)

aya_rust_crate(
    name = "integration-test",
    build_script = False,
    compile_data = [":bpf_out_dir"],
    rustc_env = {
        "OUT_DIR": "$(execpath :bpf_out_dir)",
    },
    test_binary = True,
)

opt_filegroup(
    name = "integration-test-unit-test-opt",
    srcs = [":integration-test-unit-test"],
)

host_arch_filegroup(
    name = "native-fastbuild-binary",
    srcs = [":integration-test-unit-test"],
)

host_arch_filegroup(
    name = "native-opt-binary",
    srcs = [":integration-test-unit-test-opt"],
)

[
    sh_test(
        name = "native_" + mode,
        timeout = "long",
        srcs = ["native.sh"],
        args = ["$(rootpath :" + binary + ")"],
        data = [":" + binary],
        tags = [
            "exclusive",
            "external",
            "local",
            "manual",
        ],
        target_compatible_with = ["@platforms//os:linux"],
    )
    for mode, binary in [
        ("fastbuild", "native-fastbuild-binary"),
        ("opt", "native-opt-binary"),
    ]
]

[
    aya_integration_vm_test(
        name = "vm_" + arch + "_" + line,
        config = "//test/kernel:kernel_" + line + "_config",
        ingress = "//test/kernel:kernel_" + line + "_sch_ingress",
        kernel = "//test/kernel:kernel_" + line,
        qemu_system_target = arch,
        system_map = "//test/kernel:kernel_" + line + "_system_map",
        tags = ["manual"],
    )
    for line in KERNEL_LINES
    for arch in [
        "aarch64",
        "x86_64",
    ]
]
