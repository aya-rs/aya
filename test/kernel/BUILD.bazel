load(":kernel.bzl", "KERNEL_LINES", "aya_kernel")

package(default_visibility = ["//visibility:public"])

exports_files([
    "aya_aarch64.config",
    "aya_common.config",
    "aya_x86_64.config",
    "kbuild_exporter.json",
    "kernel.BUILD.bazel",
])

[
    aya_kernel(
        name = "kernel_" + line,
        anchor = "@aya_kernel_" + line + "//:Makefile",
        sources = "@aya_kernel_" + line + "//:sources",
        syntax = "@aya_kernel_" + line + "_syntax//:program",
    )
    for line in KERNEL_LINES
]
