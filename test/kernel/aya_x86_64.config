# Architecture, boot image compression, and serial console for the x86-64 VM.
CONFIG_X86_64=y
CONFIG_ACPI=y
CONFIG_KERNEL_LZ4=y
CONFIG_EARLY_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Timer support: BPF_PROG_TEST_RUN reports elapsed nanoseconds.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_X86_PM_TIMER=y

# Keep the x86 link path simple; Aya tests do not need ORC or IBT.
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_UNWINDER_ORC=n
CONFIG_X86_KERNEL_IBT=n
