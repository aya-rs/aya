{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["schedule:weekly"],
  "enabledManagers": ["bazel-module", "cargo", "github-actions"],
  "constraints": {
    "ghActionsLock": "v0.2.0"
  },
  "separateMajorMinor": false,
  "packageRules": [
    {
      "matchManagers": ["bazel-module"],
      "groupName": "bazel-modules"
    },
    {
      "description": "Keep pahole synchronized with manual probes until aya-rs/aya#1821 removes them.",
      "matchManagers": ["bazel-module"],
      "matchPackageNames": ["pahole"],
      "enabled": false
    },
    {
      "matchManagers": ["cargo"],
      "minimumReleaseAge": "3 days",
      "groupName": "cargo-crates"
    },
    {
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "3 days",
      "groupName": "github-actions"
    },
    {
      "description": "Keep runner image selection explicit, as with Dependabot.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner"],
      "enabled": false
    }
  ]
}
