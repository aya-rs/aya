load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@bazel_skylib//rules/directory:directory.bzl", "directory")
load("@bazel_skylib//rules/directory:subdirectory.bzl", "subdirectory")
load("//bazel:codegen.bzl", "aya_bindings")
load("//bazel:rust.bzl", "aya_rust_crate")

aya_rust_crate(
    name = "xtask",
)

directory(
    name = "libbpf_files",
    srcs = glob(
        [
            "libbpf/include/**/*.h",
            "libbpf/src/*.h",
        ],
        allow_empty = True,
    ),
    tags = ["manual"],
)

subdirectory(
    name = "libbpf_headers",
    parent = ":libbpf_files",
    path = "libbpf",
    tags = ["manual"],
)

aya_bindings(name = "bindings")

write_source_files(
    name = "codegen",
    additional_update_targets = [
        "//aya-obj:update_bindings",
        "//ebpf/aya-ebpf-bindings:update_bindings",
    ],
    tags = ["manual"],
)

test_suite(
    name = "codegen_tests",
    tags = ["manual"],
    tests = [
        "//aya-obj:update_bindings_tests",
        "//ebpf/aya-ebpf-bindings:update_bindings_tests",
    ],
)
