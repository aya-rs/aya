load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//bazel:codegen_architectures.bzl", "CODEGEN_ARCHITECTURES")
load("//bazel:rust.bzl", "aya_rust_crate")

exports_files(["include/bindings.h"])

aya_rust_crate(
    name = "aya-ebpf-bindings",
    ebpf = True,
)

write_source_files(
    name = "update_bindings",
    files = {
        "src/" + arch + "/" + filename: "//xtask:generated/" + arch + "/" + filename
        for arch in CODEGEN_ARCHITECTURES
        for filename in [
            "bindings.rs",
            "helpers.rs",
        ]
    },
    suggested_update_target = "//xtask:codegen",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
