diff --git a/autoconf/private/checker/declared_process.h b/autoconf/private/checker/declared_process.h
--- /dev/null
+++ b/autoconf/private/checker/declared_process.h
@@ -0,0 +1,37 @@
+#pragma once
+#ifndef _WIN32
+#include <cerrno>
+#include <fcntl.h>
+#include <string>
+#include <vector>
+#include <sys/wait.h>
+#include <unistd.h>
+
+namespace rules_cc_autoconf {
+// Execute the toolchain's argv directly: no host shell or shell tokenization.
+inline int run_declared_argv(const std::vector<std::string>& command, bool quiet) {
+    if (command.empty()) return 127;
+    std::vector<char*> args;
+    for (const auto& arg : command) args.push_back(const_cast<char*>(arg.c_str()));
+    args.push_back(nullptr);
+    const pid_t child = fork();
+    if (child == -1) return 127;
+    if (child == 0) {
+        if (quiet) {
+            const int output = open("/dev/null", O_WRONLY);
+            if (output == -1 || dup2(output, STDOUT_FILENO) == -1 ||
+                dup2(output, STDERR_FILENO) == -1) _exit(127);
+            if (output > STDERR_FILENO) close(output);
+        }
+        execv(args[0], args.data());
+        _exit(127);
+    }
+    int status;
+    while (waitpid(child, &status, 0) == -1) {
+        if (errno != EINTR) return 127;
+    }
+    if (WIFEXITED(status)) return WEXITSTATUS(status);
+    return WIFSIGNALED(status) ? 128 + WTERMSIG(status) : 127;
+}
+}  // namespace rules_cc_autoconf
+#endif
