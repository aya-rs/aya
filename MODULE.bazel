module(
    name = "aya",
    version = "0.0.0",
)

bazel_dep(name = "aspect_rules_lint", version = "2.7.2", dev_dependency = True)

bazel_dep(name = "bazel_lib", version = "3.7.2")

# LLVM's resource directory includes filtered directory symlinks. Use the fixed
# copy tool until https://github.com/bazel-contrib/bazel-lib/pull/1303 is released.
single_version_override(
    module_name = "bazel_lib",
    patch_strip = 1,
    patches = ["//bazel:bazel_lib_copy_tool.patch"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# The archive_override below pins the exact linux.bzl revision.
bazel_dep(name = "linux.bzl", version = "0.0.0")

# libbpf supplies headers and libraries for the C BPF integration-test objects.
bazel_dep(name = "libbpf", version = "1.7.0")

# The LLVM toolchain compiles C BPF objects and the integration VM kernels.
bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_qemu", version = "0.3.0")
bazel_dep(name = "rules_rs", version = "0.0.107")
bazel_dep(name = "rules_shell", version = "0.8.0")

# CONFIG_DEBUG_INFO_BTF requires pahole when linking the integration VM kernels.
bazel_dep(name = "pahole", version = "1.31")

# Bison's runfiles helper calls getenv without including its declaring header.
single_version_override(
    module_name = "rules_bison",
    patch_strip = 1,
    patches = ["//bazel:rules_bison_cstdlib.patch"],
    version = "0.4.bcr.1",
)

# Configure probes execute declared tool arguments directly. Their serialized
# compiler paths must remain unmapped until the dependency maps its JSON too.
single_version_override(
    module_name = "rules_cc_autoconf",
    patch_strip = 1,
    patches = [
        "//bazel:rules_cc_autoconf_no_host_shell.patch",
        "//bazel:rules_cc_autoconf_no_path_mapping.patch",
    ],
    version = "0.27.0",
)

# The source-native libbpf build checks dependency headers with -Wundef.
# Keep zlib's optional feature macros valid when they are undefined.
single_version_override(
    module_name = "zlib",
    patch_strip = 1,
    patches = ["//bazel:zlib_optional_header_macros.patch"],
)

# with_cfg.bzl selects BPF target architectures and the optimized test mode.
bazel_dep(name = "with_cfg.bzl", version = "0.14.6")

# These hermetic targets are used instead of build scripts below.
bazel_dep(name = "xz", version = "5.4.5.bcr.8")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")

# //test/integration-test:bpf_out_dir uses copy_to_directory.
bazel_lib_toolchains = use_extension("@bazel_lib//lib:extensions.bzl", "toolchains")
bazel_lib_toolchains.copy_to_directory()
use_repo(bazel_lib_toolchains, "copy_to_directory_toolchains")

# Pin the source-built kernel rules.
archive_override(
    module_name = "linux.bzl",
    integrity = "sha256-lU9pRA3zeT3f1qIYbr/OHExf2bzVuuSvpzsedGdpwU0=",
    strip_prefix = "linux.bzl-99a33e09eb2e512889aa8e272e3474017c362db6",
    urls = ["https://github.com/tamird/linux.bzl/archive/99a33e09eb2e512889aa8e272e3474017c362db6.tar.gz"],
)

# linux.bzl's configured-toolchain probe API has no BCR release yet.
archive_override(
    module_name = "autoconf.bzl",
    integrity = "sha256-zi95gB21ktPCYHVMrAgikbv6rmydz7gyEhRvrP6amtw=",
    strip_prefix = "autoconf.bzl-08d970e04ac0592179d7b832e3189ae39a4e042c",
    urls = ["https://github.com/hermeticbuild/autoconf.bzl/archive/08d970e04ac0592179d7b832e3189ae39a4e042c.tar.gz"],
)

# @rules_rs creates @rules_rust here; generated BUILD files and .bazelrc labels
# reference @rules_rust directly.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# Aya's eBPF crates use asm_experimental_arch and core_intrinsics,
# so the hermetic Rust toolchain must be a pinned nightly.
# CI reads these same version attributes; scripts/rust-toolchain-pins.py
# advances them with Buildozer.
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    name = "default_rust_toolchains",
    edition = "2024",
    version = "nightly/2026-10-21",
)

# Integration CI selects stable for userspace; bazel/bpf.bzl selects nightly
# for its eBPF dependencies.
toolchains.toolchain(
    name = "stable_rust_toolchains",
    edition = "2024",
    version = "1.99.1",
)
use_repo(toolchains, "default_rust_toolchains", "stable_rust_toolchains")

# Each qemu-system toolchain is compatible with the corresponding
# //bazel:bpf_target_arch value. bazel/vm.bzl transitions that value for each
# integration VM test.
qemu = use_extension("@rules_qemu//qemu/extension:qemu.bzl", "qemu")
qemu.system_toolchain(
    system_target = "aarch64-softmmu",
    target_settings = ["//bazel:bpf_target_arch_aarch64"],
)
qemu.system_toolchain(
    system_target = "x86_64-softmmu",
    target_settings = ["//bazel:bpf_target_arch_x86_64"],
)

# rules_qemu declares both repositories as root-module direct dependencies;
# Aya registers only qemu_system_toolchains below.
use_repo(qemu, "qemu_system_toolchains", "qemu_user_toolchains")

# macOS VM invocations select the Homebrew QEMU toolchain with --extra_toolchains.
homebrew_qemu_repository = use_repo_rule("//bazel:homebrew_qemu.bzl", "homebrew_qemu_repository")

homebrew_qemu_repository(name = "homebrew_qemu")

register_toolchains(
    "@copy_to_directory_toolchains//:all",
    "@default_rust_toolchains//...",
    "@linux.bzl//execution_tools:linux_x86_64",
    "@llvm//toolchain:all",
    "@qemu_system_toolchains//:all",
    "@stable_rust_toolchains//...",
)

# Generate Cargo dependencies for every Rust execution and target platform used
# by Aya's local hosts, integration VMs, and BPF targets.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "bpfeb-unknown-none",
        "bpfel-unknown-none",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)

# Replace build scripts with hermetic targets.
crate.annotation(
    crate = "lzma-sys",
    gen_build_script = "off",
    deps = ["@xz//:lzma"],
)
crate.annotation(
    crate = "zstd-sys",
    gen_build_script = "off",
    deps = ["@zstd"],
)

# Replace libbpf-sys's build.rs with @libbpf and export the bundled vmlinux.h
# used by //test/integration-test:c_bpf_objects.
crate.annotation(
    additive_build_file_content = """
exports_files(
    ["libbpf/.github/actions/build-selftests/vmlinux.h"],
    visibility = ["//visibility:public"],
)
""",
    crate = "libbpf-sys",
    extra_aliased_targets = {
        "libbpf-sys-vmlinux-h": "libbpf/.github/actions/build-selftests/vmlinux.h",
    },
    gen_build_script = "off",
    deps = ["@libbpf"],
)
use_repo(crate, "crates")

