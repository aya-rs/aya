# Defines the root Bazel package used by the //:Cargo.toml and //:Cargo.lock
# labels in MODULE.bazel.

load("@aspect_rules_lint//format:defs.bzl", "format_multirun")

format_multirun(
    name = "format",
    starlark = "@buildifier_prebuilt//:buildifier",
    starlark_check_args = [
        "-mode=check",
        "-lint=warn",
    ],
    starlark_fix_args = [
        "-mode=fix",
        "-lint=fix",
    ],
)
